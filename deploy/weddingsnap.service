# Installed by deploy/deploy.sh (APP_DIR and APP_USER are filled in).
[Unit]
Description=WeddingSnap web app (gunicorn)
After=network.target

[Service]
User=APP_USER
Group=APP_USER
WorkingDirectory=APP_DIR
# Fewer glibc memory arenas: keeps memory steady with indexing threads.
Environment=MALLOC_ARENA_MAX=2
ExecStart=APP_DIR/.venv/bin/gunicorn -c APP_DIR/gunicorn.conf.py weddingsnap.wsgi
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
