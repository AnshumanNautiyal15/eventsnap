# Production settings for the server. setup.sh copies this to /srv/weddingsnap/.env; fill in every value.
DJANGO_DEBUG=0
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Your domain, without https://
DJANGO_ALLOWED_HOSTS=photos.example.com
# Full address guests reach; it goes into every QR code
PUBLIC_BASE_URL=https://photos.example.com
# Generate: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=

# Cloudflare R2 (photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=weddingsnap-prod
# Nightly database backups (same R2 keys; the token must also allow this bucket)
BACKUP_R2_BUCKET=weddingsnap-backups

# Storage for a new photographer until you change it in the admin (GB)
DEFAULT_STORAGE_GB=1
