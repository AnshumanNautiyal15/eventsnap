# Copy to .env and fill in. .env is loaded automatically and is git-ignored.

# Google Drive linking is OFF by default (photographers upload; photos are stored in R2).
# Set to 1 to offer Drive folders again, together with the keys below.
# GOOGLE_DRIVE_ENABLED=0

# Google Drive, "Anyone with the link" folders: API key restricted to the Google Drive API
GOOGLE_API_KEY=

# Optional, only for private folders: OAuth client of type "Web application"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Cloudflare R2 for uploaded photos and previews (leave empty to store them on this machine).
# R2 dashboard → your bucket; R2 → Manage API tokens → Create token with "Object Read & Write" on that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=               # only for EU-jurisdiction buckets: https://<account id>.eu.r2.cloudflarestorage.com

# Storage a new photographer gets until you change it in the admin (GB)
# DEFAULT_STORAGE_GB=1

# Address phones use to reach the server; it is put in the QR codes
PUBLIC_BASE_URL=

# FACE_MATCH_THRESHOLD=0.40
# Indexing runs in batches; defaults are picked from the machine's RAM and CPU (see README → Indexing).
# INDEX_BATCH_SIZE=         # photos per batch
# INDEX_BATCH_PAUSE=        # seconds to rest between batches
# INDEX_CPU_SLOTS=          # photos analysed at once
# INDEX_DOWNLOADS=          # photos fetched/held in memory at once
# FACE_MODEL_COPIES=        # loaded face-model copies (~60 MB each)
# DRIVE_AUTO_SYNC_MINUTES=5
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=*
